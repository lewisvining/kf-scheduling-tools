{
  "manifest_version": 3,
  "name": "Kraken Field Scheduling Tools",
  "version": "2.0",
  "description": "@lewis.vining",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "clipboardWrite",
    "power"
  ],
  "host_permissions": [
    "*://*/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js" 
  },
  "content_scripts": [
    {
      "matches": ["https://field.oes-prod.energy/*"],
      "js": [
        "hideMasquerade.js",
        "jobCopyButtons.js",
        "c2cScheduling.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "web_accessible_resources": [
  {
    "resources": ["engineer_data.json"],
    "matches": ["<all_urls>"]
  }
  ]
}